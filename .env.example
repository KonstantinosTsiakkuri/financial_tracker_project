# Базовая ссылка на API (по умолчанию используется открытое API ЦБ РФ)
EXCHANGE_API_URL=https://www.cbr-xml-daily.ru/daily_json.js

# Секретный API-ключ (для ЦБ РФ оставь пустым или впиши заглушку,
# для платных сервисов вроде ExchangeRate-API вставь сюда свой токен)
EXCHANGE_API_KEY=your_secret_api_key_here